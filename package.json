{
  "name": "pi-copilot-model-discovery",
  "version": "0.1.1",
  "description": "Lean, provider-driven GitHub Copilot model discovery for pi.",
  "type": "module",
  "license": "MIT",
  "author": "perbellinioa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perbellinioa/pi-copilot-model-discovery.git"
  },
  "bugs": {
    "url": "https://github.com/perbellinioa/pi-copilot-model-discovery/issues"
  },
  "homepage": "https://github.com/perbellinioa/pi-copilot-model-discovery#readme",
  "packageManager": "npm@11.17.0",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "github-copilot",
    "model-discovery"
  ],
  "files": [
    "src/",
    "README.md",
    "BENCHMARKS.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "validate": "npm run check && npm test",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
